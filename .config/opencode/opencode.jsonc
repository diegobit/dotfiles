{
  "$schema": "https://opencode.ai/config.jsonc",
  "autoupdate": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--no-performance-crux"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chrome",
          "--caps",
          "devtools"
        ]
      },
      "icloud-mail": {
        "type": "remote",
        "url": "https://icloud-mail.diegobit.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:ICLOUD_MAIL_TOKEN}"
        }
      },
      "rivolo": {
        "type": "remote",
        "url": "https://mcp.rivolo.app/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.rivolo-token}"
        }
      },
      "raindrop": {
        "type": "remote",
        "url": "https://raindrop-mcp.diegobit.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.raindrop-mcp-token}"
        }
      }
    }
  },
  // Bookmark deletion stays available; collections and tags do not.
  "permissions": [
    { "action": "raindrop_delete_collections", "resource": "*", "effect": "deny" },
    { "action": "raindrop_delete_tags", "resource": "*", "effect": "deny" }
  ]
  //"plugin": ["@mohak34/opencode-notifier@latest"]
}
