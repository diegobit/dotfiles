{
  "$schema": "https://opencode.ai/config.jsonc",
  "autoupdate": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "/Users/diego/.local/share/mise/installs/node/24/bin/npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--no-performance-crux"
        ],
        "environment": {
          "PATH": "/Users/diego/.local/share/mise/installs/node/24/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "/Users/diego/.local/share/mise/installs/node/24/bin/npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chrome",
          "--caps",
          "devtools"
        ],
        "environment": {
          "PATH": "/Users/diego/.local/share/mise/installs/node/24/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "icloud-mail": {
        "type": "remote",
        "url": "https://icloud-mail.diegobit.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.icloud-mail-token}"
        }
      },
      "raindrop": {
        "type": "remote",
        "url": "https://raindrop-mcp.diegobit.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.raindrop-mcp-token}"
        }
      },
      "icloud-notes": {
        "type": "local",
        "command": [
          "/Users/diego/.local/share/mise/installs/node/24/bin/node",
          "/Users/diego/code/dg/icloud-notes-mcp/src/server.mjs"
        ],
        "environment": {
          "PATH": "/Users/diego/.local/share/mise/installs/node/24/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "rivolo-diego": {
        "type": "remote",
        "url": "https://mcp.rivolo.app/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.rivolo-token}"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "raindrop_delete_collections",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "raindrop_delete_tags",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "plugin": [
    "opencode-scheduled-tasks"
  ]
}
