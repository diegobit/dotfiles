.config/karabiner/*backups/
.config/karabiner/assets/complex_modifications/
**.add
**.spl
**.sug
.*api_key*
# Colima's home is ~/.config/colima, a real directory OUTSIDE this repo: it
# holds tens of GB of VM state (_lima, disks, datadisk). Only the per-profile
# colima.yaml lives here, symlinked into that home. These are belt-and-braces
# in case the whole dir ever gets linked in again.
.config/colima/*
!.config/colima/default/
!.config/colima/amd64/
.config/colima/default/*
!.config/colima/default/colima.yaml
.config/colima/amd64/*
!.config/colima/amd64/colima.yaml
.config/aichat/.env

# docextract: compiled Swift helper is built on first use
agent-skills/docextract/scripts/vision_ocr
agent-skills/docextract/scripts/__pycache__/
